{
  "openapi": "3.1.0",
  "info": {
    "title": "Budgie",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Service, database and model status",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Db"
          },
          "llm": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ],
            "title": "Llm"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "status",
          "db",
          "llm",
          "model"
        ],
        "title": "Health",
        "description": "`GET /api/health`. Always returned with 200 while the app runs."
      }
    }
  }
}
